{
  "name": "coast-backend",
  "version": "0.0.1",
  "description": "Coast Fragrances commerce backend (Medusa v2)",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "medusa build && cd .medusa/server && npm install --omit=dev --no-audit --no-fund",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "bootstrap": "medusa exec ./src/scripts/bootstrap.ts",
    "dev": "medusa develop",
    "start": "cd .medusa/server && export NODE_ENV=production && npm run predeploy && npx medusa start",
    "predeploy": "medusa db:migrate && medusa exec ./src/scripts/bootstrap.js",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.21.1",
    "@medusajs/cli": "2.21.1",
    "@medusajs/framework": "2.21.1",
    "@medusajs/medusa": "2.21.1"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.21.1",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14"
  },
  "engines": {
    "node": "22.x"
  }
}
