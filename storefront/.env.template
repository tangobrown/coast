# URL of the Medusa backend (no trailing slash)
MEDUSA_BACKEND_URL=http://localhost:9000
# Publishable API key — printed in the backend's deploy logs, or Medusa Admin → Settings → Publishable API Keys
MEDUSA_PUBLISHABLE_KEY=
# Stripe publishable key (pk_test_... or pk_live_...). Leave empty until Stripe is set up.
STRIPE_PUBLISHABLE_KEY=
# Announcement bar copy (optional)
NEXT_PUBLIC_ANNOUNCEMENT=Free UK delivery over £30 · Refills from £6 · Real fragrance, never fake
# Set to "true" ONLY for testing without Stripe: lets checkout place unpaid test orders.
ALLOW_TEST_ORDERS=false
